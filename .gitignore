# .gitignore - Python

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing / coverage
.coverage
htmlcov/
.pytest_cache/
.tox/
.mypy_cache/

# Environment secrets
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
desktop.ini

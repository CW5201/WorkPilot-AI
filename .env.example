# WorkPilot 企业办公数字员工 · 环境变量示例（复制为 .env）
# 所有密钥/连接通过环境变量注入，不落盘、不硬编码。

# ---- LLM（OpenAI 兼容；可指向 vLLM / DashScope / OpenAI）----
LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2

# 无 key 时用规则式 Planner/Reporter 离线跑通 demo（保持 true）
LLM_FALLBACK_RULE_BASED=true

# ---- PostgreSQL ----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=workpilot
PG_PASSWORD=workpilot
PG_DB=workpilot

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Milvus（Retriever 向量检索）----
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=workpilot_knowledge
MILVUS_DIM=1024

# ---- HITL ----
# 演示可设 true 自动放行高风险；生产保持 false
APPROVAL_AUTO_GRANT=false
